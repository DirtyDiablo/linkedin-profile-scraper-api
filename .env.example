# LinkedIn Profile Scraper Configuration
# ======================================
#
# REQUIRED: Your LinkedIn li_at session cookie
# How to get this value:
# 1. Log into LinkedIn in your browser
# 2. Open Developer Tools (F12)
# 3. Go to Application tab > Cookies > linkedin.com
# 4. Find the cookie named "li_at" and copy its value
#
LINKEDIN_SESSION_COOKIE_VALUE=your_li_at_cookie_value_here

# Optional: Port for the API server (defaults to 3000)
PORT=3000
